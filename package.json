{
  "name": "generate-test-with-copilot",
  "version": "1.0.0",
  "description": "Demonstração prática do MCP Playwright para automação de testes e geração de artefatos de qualidade - Chapter Técnico QE 21/08/2025",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "test:saucedemo": "npx playwright test saucedemo",
    "test:purchase-flow": "npx playwright test saucedemo-purchase-flow",
    "test:additional": "npx playwright test saucedemo-additional-scenarios",
    "install:browsers": "npx playwright install",
    "test:ci": "npx playwright test --reporter=github"
  },
  "keywords": [
    "playwright",
    "mcp",
    "quality-engineering",
    "automation",
    "testing",
    "postman",
    "api-testing",
    "e2e-testing",
    "page-object-model"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juniorschmitz/mcp-playwright-examples.git"
  },
  "bugs": {
    "url": "https://github.com/juniorschmitz/mcp-playwright-examples/issues"
  },
  "homepage": "https://github.com/juniorschmitz/mcp-playwright-examples#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0-alpha-2025-05-12",
    "@types/node": "^22.15.14"
  }
}
