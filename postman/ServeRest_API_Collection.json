  "item": [
    {
      "name": "Authentication",
      "description": "Endpoints relacionados à autenticação de usuários",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/login",
              "host": ["{{baseURL}}"],
              "path": ["login"]
            },
            "description": "Realiza login no sistema. A duração do token retornado é de 600 segundos (10 minutos)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains message and authorization', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('message');",
                  "    pm.expect(responseJson).to.have.property('authorization');",
                  "});",
                  "",
                  "pm.test('Authorization token is Bearer token', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.authorization).to.match(/^Bearer .+/);",
                  "});",
                  "",
                  "// Salva o token para uso em outras requisições",
                  "if (pm.response.code === 200) {",
                  "    const responseJson = pm.response.json();",
                  "    pm.environment.set('authToken', responseJson.authorization);",
                  "}",
                  "",
                  "pm.test('Response time is less than 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
