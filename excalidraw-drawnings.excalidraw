      "updated": 1755785817583,
      "link": null,
      "locked": false,
      "text": "- Mapeamento de seletores\n- Testes exploratórios\n-> Mapeamento de cenários\n- Validação de layout\n- Self-healing\n- Testes de regressão\n- Comparar Figma com o Layout do Site\n- Sugestão de melhorias de layout\n- Sugestão de melhorias no código\n- Execução de testes em pipelines\n- Testes de acessibilidade\n\nOpenText(?)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Mapeamento de seletores\n- Testes exploratórios\n-> Mapeamento de cenários\n- Validação de layout\n- Self-healing\n- Testes de regressão\n- Comparar Figma com o Layout do Site\n- Sugestão de melhorias de layout\n- Sugestão de melhorias no código\n- Execução de testes em pipelines\n- Testes de acessibilidade\n\nOpenText(?)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "b7XFKiHTmAgtIq79cUZOW",
      "type": "text",
      "x": 3654.212671054978,
      "y": 2077.150711936418,
      "width": 1136.638916015625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
